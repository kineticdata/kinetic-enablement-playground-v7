# setup.mjs-generated MCP client config. It holds no credentials (only the
# space's MCP URL), but it is per-partner: it names their own space.
# .vscode/mcp.json is already covered by the .vscode/* rule above; .cursor only
# ignores mcp.json — .cursor/rules/ stays tracked.
.cursor/mcp.json
